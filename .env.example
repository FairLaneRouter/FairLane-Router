# ── Джерело даних ────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://example-rpc.invalid/?api-key=REPLACE_ME
SOLANA_RPC_FALLBACK_URL=

# Частоти вибірки. Калібровані на mainnet 2026-08-28 (PLAN.md → Калібрування):
# 688 невотингових у слоті, getBlock full — 7.2 МБ. За кроком 100 це 15.5 ГБ
# JSON на добу; нижче опускати не варто — впирається процесор, не тариф.
SAMPLE_EVERY_N=100
RPC_SAMPLE_RATE=0.05

# ── База даних ───────────────────────────────────────────────────────────────
# Пулер, режим транзакцій — усе, крім міграцій (Supabase, порт 6543).
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Пряме з'єднання, порт 5432 — тільки міграції: DDL і блокування за пулером
# ламаються не завжди, а іноді, і саме тому найгірше.
DATABASE_DIRECT_URL=

# ── API ──────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
RATE_LIMIT_WITH_KEY_PER_MIN=120
RATE_LIMIT_NO_KEY_PER_MIN=10

# ── Веб (apps/web) ───────────────────────────────────────────────────────────
# Адреса API для бандла. Вшивається на збірці, тому змінюється лише
# перезбіркою. Порожнє значення = той самий домен, що й сторінка (розгортання
# за одним проксі). Не задано у розробці = http://127.0.0.1:3000.
VITE_API_URL=

# ── Демо-гаманець парного порівняння (M3) ────────────────────────────────────
# Ключ проекту, не користувача. Мікросуми. Тільки через оточення, ніколи в коді.
DEMO_WALLET_SECRET=
DEMO_DAILY_BUDGET_LAMPORTS=50000000
DEMO_PER_RUN_LAMPORTS=2000000

# ── Ендпоінти каналів відправки (M3) ─────────────────────────────────────────
# Порожнє значення = канал лишається тільки для спостереження (FR-040).
CHANNEL_JITO_ENDPOINT=
CHANNEL_NOZOMI_ENDPOINT=
CHANNEL_BLOXROUTE_ENDPOINT=
