{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'збірки немає: Node виконує TypeScript напряму (див. README)'",
    "watchPatterns": [
      "apps/indexer/**",
      "packages/shared/**",
      "packages/db/**",
      "pnpm-lock.yaml",
      ".nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "node apps/indexer/src/index.ts",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
